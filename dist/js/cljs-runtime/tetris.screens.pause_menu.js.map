(ns tetris.screens.pause-menu
  (:require-macros [cljss.core])
  (:require
    [cljss.core :as css :refer-macros [defstyles]]
    [tetris.screens.menu-system :as menu-sys]
    [tetris.screens.screen-stack :as screen-stack]))

(defstyles class-menu-item [id]
  {:padding "8px 0"
   :margin-top (if (= id :back) 16 0)
   :font-size "24px"
   :text-align "center"
   :color "#aaa"})

(defstyles class-hover []
  {:color "#fff"
   :text-shadow "0 0 2px #fee"})

(def zh-cn
  {:back "继续"
   :start-over "重新开始"
   :back-to-main-menu "返回到主菜单"})

(defn menu-overlay [state]
  [:div
   (list
     (map (fn [item-id]
            [:div {:key item-id
                   :class [(class-menu-item item-id)
                           (when (= (:hover state) item-id) (class-hover))]}
             (get zh-cn item-id (name item-id))])
          (menu-sys/show-active-menu-items state)))])

(defn on-keydown [state event on-enter]
  (let [key (.-code event)]
    (cond
      (= key "ArrowDown") (menu-sys/select state +1)
      (= key "ArrowUp") (menu-sys/select state -1)
      (= key "Escape") (on-enter :cancel)
      (= key "Enter")
      (cond
        (= (:hover state) :back) (menu-sys/back-to-parent state)
        :else (case (:hover state)
                :back-to-main-menu (screen-stack/enter :main-menu)
                (on-enter (:hover state)))))))
