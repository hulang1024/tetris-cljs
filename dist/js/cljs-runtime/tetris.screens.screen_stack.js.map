(ns tetris.screens.screen-stack
  (:require
    [reagent.core :as r]
    [reagent.ratom :as ratom]
    [reagent.dom.client :as rd]
    [tetris.screens.screen :as screen]))

(defonce ^:private app
  (r/atom {:active-screen nil
           :stack []
           :screen-states {}}))

(defn- get-screen-state [id]
  (get (:screen-states @app) id))

(defonce ^:private root
  (delay (rd/create-root (.getElementById js/document "app"))))

(defn- add-class [view class-name]
  (let [[tag attrs & children] view]
    (into [tag]
          (if (map? attrs)
            [(merge {:class (conj (flatten [(:class attrs)]) class-name)}
                    (dissoc attrs :class))
             children]
            [{:class class-name} attrs children]))))

(defn- render-active-screen []
  (when (:active-screen @app)
    (when-let [view (screen/render (get-screen-state (:active-screen @app)))]
      (add-class view
                 (str "screen-" (name (:active-screen @app)))))))

(defn- enter-screen [screen-id args]
  (when (:active-screen @app)
    (screen/on-exiting (get-screen-state (:active-screen @app))))
  (swap! app assoc :active-screen nil)
  (let [apply-screen (fn [screen-state app]
                       (let [with-id (fn [m] (assoc (or m {}) :id screen-id))
                             screen-state (-> (if (instance? ratom/RAtom screen-state)
                                                (do (swap! screen-state with-id) screen-state)
                                                (r/atom (with-id screen-state))))]
                         (assoc app
                                :active-screen screen-id
                                :screen-states (assoc (:screen-states app)
                                                      screen-id
                                                      screen-state))))]
    (if-let [screen-state (get-in @app [:screen-states screen-id])]
      (do (apply screen/on-entering screen-state args)
          (apply screen/on-resuming screen-state args)
          (swap! app (partial apply-screen screen-state)))
      (let [screen-state (apply screen/init screen-id args)]
        (if (instance? js/Promise screen-state)
          (.then screen-state (fn [screen-state]
                                (apply screen/on-entering screen-state args)
                                (swap! app (partial apply-screen screen-state))))
          (let [app' (apply-screen screen-state @app)]
            (apply screen/on-entering
                   (get-in app' [:screen-states (:active-screen app')])
                   args)
            (reset! app app')))))))

(defn push-screen [screen-id & args]
  (tap> (str "push screen: " screen-id ", args: " args))
  (swap! app update :stack conj [screen-id args])
  (enter-screen screen-id args)
  (tap> @app))

(defn back-screen []
  (tap> "back screen: ")
  (when (peek (:stack @app))
    (swap! app update :stack pop)
    (apply enter-screen (peek (:stack @app)))
    (tap> @app)))

(defn go-screen [screen-id & args]
  (tap> (str "go screen: " screen-id ", args: " args))
  (enter-screen screen-id args)
  (tap> @app))

(defn- on-keydown [event]
  (when-let [screen-state (get-screen-state (:active-screen @app))]
    (let [handled? (screen/on-keydown screen-state event)]
      (when (and (not handled?) (= (.-code event) "Escape"))
        (back-screen)))))

(defn render []
  (.removeEventListener js/window "keydown" on-keydown)
  (.addEventListener js/window "keydown" on-keydown)
  (rd/render @root [render-active-screen]))

