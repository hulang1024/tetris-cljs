(ns tetris.screens.menu)

(defn menu-item [id parent order & data]
  {id {:parent parent :data (first data) :order order}})

(defn make-menu-system [menus]
  {:active nil
   :hover :solo
   :menus menus})

(defn children [state menu-id]
  (->> (reduce-kv (fn [xs id p]
                    (if (= (:parent p) menu-id) (conj xs [id p]) xs))
                  []
                  (:menus state))
       (sort #(- (:order (second %1)) (:order (second %2))))
       (mapv first)))

(defn menu? [state menu-id]
  (boolean (seq (children state menu-id))))

(defn show-active-menu-items [state]
  (let [items (children state (:active state))]
    (if (:active state)
      (conj items :back)
      items)))

(defn select [state dir]
  (let [items (show-active-menu-items state)
        prev-index (first (keep-indexed (fn [i id]
                                          (when (= id (:hover state)) i))
                                        items))
        curr-index (mod (+ prev-index dir) (count items))]
    (assoc state :hover (nth items curr-index))))

(defn hover-first [state]
  (if-let [children (seq (children state (:active state)))]
    (assoc state :hover (nth children 0))
    state))

(defn enter-hover-menu [state]
  (-> (assoc state :active (:hover state))
      (hover-first)))

(defn back-to-top [state]
  (-> (assoc state :active nil)
      (hover-first)))

(defn back-to-parent [state]
  (if (:active state)
    (-> (assoc state
               :active (:parent ((:active state) (:menus state))))
        (hover-first))
    state))


