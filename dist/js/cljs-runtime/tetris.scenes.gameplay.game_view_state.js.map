(ns tetris.scenes.gameplay.game-view-state
  (:require
    [tetris.core.board :as b]
    [tetris.core.game :as game]
    [tetris.core.piece :as p]
    [tetris.core.tick :as tick]
    [tetris.render.constants :refer [design-height design-width]]))

(defn container-layout-schema [& more]
  (into [:map
         [:x :int]
         [:y :int]
         [:width :int]
         [:height :int]]
        more))

(def Layout
  (container-layout-schema
    [:hold (container-layout-schema)]
    [:board (container-layout-schema
              [:skyline-height :int]
              [:border-width :int]
              [:cell-offset :int]
              [:cell-size :int])]
    [:next (container-layout-schema)]))

(def DisplayPiece
  [:map
   [:color-index :int]
   [:visible :boolean]
   [:cells
    [:vector
     [:map
      [:x :int]
      [:y :int]]]]])

(def GameViewState
  [:map
   [:layout Layout]
   [:piece-style :string]
   [:current DisplayPiece]
   [:ghost DisplayPiece]
   [:hold DisplayPiece]
   [:next-queue [:vector DisplayPiece]]
   [:blocks
    [:vector
     [:map
      [:id :int]
      [:color-index :int]
      [:x :int]
      [:y :int]]]]])

(defn calc-layout
  {:malli.core/schema [:=> [:cat :int] Layout]}
  [preview-count]
  (let [screen-w design-width
        screen-h design-height
        cell-size 38
        board-border-w 3
        board-padding 2
        skyline-height (* b/skyline-rows cell-size)
        board-w (+ (* b/board-cols cell-size) board-border-w (* 2 board-padding))
        board-h (+ (- (* b/board-rows cell-size) skyline-height) board-border-w (* 2 board-padding))
        gap cell-size
        hold-w (* cell-size 4)
        hold-h (* cell-size 4)
        next-w (* cell-size 4)
        next-h (* cell-size 4 preview-count)
        game-view-w (+ hold-w gap board-w gap next-w)
        game-view-h board-h]
    {:x (/ (- screen-w game-view-w) 2)
     :y (/ (- screen-h game-view-h) 2)
     :width game-view-w
     :height game-view-h
     :hold {:x 0
            :y 0
            :width hold-w
            :height hold-h}
     :board {:x (+ hold-w gap)
             :y skyline-height
             :width board-w
             :height board-h
             :skyline-height skyline-height
             :border-width board-border-w
             :cell-offset (+ (/ board-border-w 2) board-padding)
             :cell-size cell-size}
     :next {:x (+ hold-w gap board-w gap)
            :y 0
            :width next-w
            :height next-h}}))

(defn- cell-position-in-board [layout row col]
  (let [board-layout (get-in layout [:board])
        offset-x (:cell-offset board-layout)
        offset-y (- (:cell-offset board-layout) (:skyline-height board-layout))
        cell-size (:cell-size board-layout)]
    {:x (+ offset-x (* cell-size col))
     :y (+ offset-y (* cell-size row))}))

(defn- piece-position-in-board [layout piece row col]
  (vec (for [[cr cc] (:cells piece)
             :let [row (+ row cr)
                   col (+ col cc)]]
         (cell-position-in-board layout row col))))

#_(defn- clear-lines [render-state state event ^js container]
    (let [board (.getChildByLabel container "board")
          all-cells (js->clj (.getChildrenByLabel board (js/RegExp. "cell")))
          find-cells (fn [row-indices all-cells]
                       (filterv (fn [cell]
                                  (contains? row-indices (:row (aget cell "data"))))
                                all-cells))
          cells-to-die (find-cells (:row-indices event) all-cells)
          drop-moves []#_(line-clear-drop-moves (:last-board event) (:row-indices event))
          delay-ms (util/frames->ms (ruleset/line-clear-delay state))]
      (run! #(.destroy ^js %) (:ghost render-state))
      (run! #(.destroy ^js %) cells-to-die)
      (doseq [[cells to-row] (map (fn [[from-row to-row]]
                                    [(find-cells #{from-row} all-cells) to-row])
                                  drop-moves)]
        (println (mapv #(aget % "data")cells) to-row)
        (run! (fn [cell]
                (set-cell-position-in-board
                  cell
                  (:layout render-state)
                  to-row
                  (:col (aget cell "data"))))
              cells))
      render-state))

(defn modern-color [kind]
  (+ 2 (first (keep-indexed
                (fn [i k] (when (= k kind) i))
                p/piece-kinds))))

(defn initial-state [game-state]
  {:layout (calc-layout (:preview-count game-state))
   :piece-style "b11"
   :blocks []
   :current nil
   :ghost nil
   :hold nil
   :next-queue []})

(defn blocks [state game-state]
  (let [cells
        (for [[r xs] (map-indexed vector (:board game-state))
              [c cell] (map-indexed vector xs)
              :when cell]
          (conj {:id (:id cell)
                 :color-index (modern-color (:kind cell))}
                (cell-position-in-board (:layout state) r c)))]
    (assoc state :blocks cells)))

(defn spawn-piece [state game-state]
  (if (game/find-event :spawn-piece (:events game-state))
    (assoc state
           :current {:color-index (modern-color (get-in game-state [:current :kind]))
                     :visible true
                     :cells []}
           :ghost {:color-index 0
                   :visible true
                   :cells []})
    state))

(defn update-current [state game-state]
  (-> (if (:current game-state)
        (-> (assoc-in state [:current :cells]
                      (piece-position-in-board
                        (:layout state)
                        (:current game-state)
                        (:row game-state)
                        (:col game-state)))
            (assoc-in [:current :visible] true))
        (assoc-in state [:current :visible] false))))

(defn- update-ghost [state game-state]
  (if (:ghost-enabled? game-state)
    (-> (assoc state [:ghost :visible] (:current game-state))
        (assoc-in [:ghost :cells]
                  (piece-position-in-board
                    (:layout state)
                    (:current game-state)
                    (get-in game-state [:ghost :row])
                    (get-in game-state [:ghost :col]))))
    state))

(defn update-state
  {:malli.core/schema [:=> [:cat GameViewState game/State] GameViewState]}
  [state game-state]
  (-> state
      (spawn-piece game-state)
      (update-current game-state)
      (update-ghost game-state)
      (blocks game-state)))
