(ns tetris.screens.components
  (:require-macros [cljss.core])
  (:require
    [cljss.core :as css :refer-macros [defstyles]]))

(defstyles button-class []
  {:font-size "1rem"
   :z-index 2})

(defn tip-button [button text]
  [:div {:class (button-class)} (str button text)])

(defn tip-buttons-overlay []
  [:div
   (tip-button "Enter" "选择")
   (tip-button "Esc" "返回")])
