(ns tetris.screens.language)

(def zh-cn
  {:back "返回"
   :solo "单人"
   :multiplayer "多人"
   :40L "40行"
   :classic "经典"
   :marathon "马拉松"
   :options "选项"
   :controls-options "控制"
   :gameplay-options "游戏"
   :audio-options "音频"
   :start-over "重新开始"
   :back-to-main-menu "返回到主菜单"
   :continue-game "继续游戏"
   :exit-game "退出游戏"
   :continue-replay "继续回放"
   :exit-replay "退出回放"
   :replay "观看回放"})

(defn text [id]
  (get zh-cn id))
