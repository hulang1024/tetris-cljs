{:deps true
 :dev-http {9000 ["."]}
 :builds
 {:app {:target :browser
        :output-dir "out"
        :asset-path "/js"
        :compiler-options {:optimizations :advanced}
        :runtime :browser
        :modules {:main {:preloads [tetris.dev-preload]
                         :init-fn tetris.main/init}}}}
 :nrepl {:port 7888}}
